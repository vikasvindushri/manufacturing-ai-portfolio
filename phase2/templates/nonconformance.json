{
  "metadata": {
    "workflow_id": "nonconformance_v1",
    "name": "Nonconformance Management",
    "description": "Guided containment, disposition, and closure for a synthetic manufacturing nonconformance.",
    "version": "1.0.0",
    "owner": "Manufacturing AI Studio",
    "status": "draft",
    "definition_version": "1.1",
    "tags": [
      "quality",
      "nonconformance"
    ]
  },
  "fields": [
    {
      "field_id": "record_id",
      "label": "Record ID",
      "field_type": "text",
      "required": true
    },
    {
      "field_id": "description",
      "label": "Nonconformance description",
      "field_type": "textarea",
      "required": true,
      "validation": {
        "min_length": 10
      }
    },
    {
      "field_id": "suspect_quantity",
      "label": "Suspect quantity",
      "field_type": "integer",
      "required": true,
      "validation": {
        "minimum": 1
      }
    },
    {
      "field_id": "severity",
      "label": "Severity",
      "field_type": "select",
      "required": true,
      "options": [
        "low",
        "medium",
        "high"
      ]
    }
  ],
  "rules": [
    {
      "rule_id": "critical_nc",
      "field_id": "severity",
      "operator": "equals",
      "value": "high",
      "message": "High severity requires quality manager review.",
      "priority": 10
    }
  ],
  "routing_actions": [
    {
      "action_id": "route_quality_manager",
      "when_rule_id": "critical_nc",
      "action_type": "require_approval",
      "value": "quality_manager"
    }
  ],
  "prompts": [],
  "output_schemas": [
    {
      "schema_id": "nonconformance_output",
      "fields": [
        {
          "field_id": "containment",
          "label": "Containment",
          "field_type": "string",
          "required": true
        },
        {
          "field_id": "disposition",
          "label": "Disposition",
          "field_type": "string",
          "required": true
        }
      ]
    }
  ],
  "ai_policy": {
    "enabled": false,
    "capability": null,
    "prompt_template_id": null,
    "allowed_classifications": [
      "synthetic",
      "public",
      "internal_non_sensitive"
    ],
    "fallback": "local_result",
    "human_approval_required": true
  },
  "allowed_input_classifications": [
    "synthetic",
    "public",
    "internal_non_sensitive",
    "confidential_restricted"
  ],
  "approval": {
    "required": true,
    "minimum_approvals": 1,
    "allowed_roles": [
      "quality_engineer",
      "quality_manager"
    ],
    "rationale_required": true,
    "creator_may_approve": false
  },
  "test_cases": [
    {
      "test_case_id": "nonconformance_synthetic_case",
      "name": "Synthetic preview case",
      "classification": "synthetic",
      "input": {
        "record_id": "SYN-NC-001",
        "description": "Synthetic dimensional result outside demonstration tolerance",
        "suspect_quantity": 12,
        "severity": "high"
      },
      "expected_rule_ids": [
        "critical_nc"
      ],
      "expected_routing_action_ids": [
        "route_quality_manager"
      ]
    }
  ],
  "extensions": {
    "catalog": {
      "featured": true
    }
  }
}
