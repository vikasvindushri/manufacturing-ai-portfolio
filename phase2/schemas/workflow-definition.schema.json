{
  "$defs": {
    "AICapability": {
      "enum": [
        "structured_review",
        "grounded_synthesis",
        "semantic_search"
      ],
      "title": "AICapability",
      "type": "string"
    },
    "AIPolicy": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "capability": {
          "anyOf": [
            {
              "$ref": "#/$defs/AICapability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prompt_template_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Template Id"
        },
        "allowed_classifications": {
          "items": {
            "$ref": "#/$defs/DataClassification"
          },
          "title": "Allowed Classifications",
          "type": "array"
        },
        "fallback": {
          "default": "local_result",
          "title": "Fallback",
          "type": "string"
        },
        "human_approval_required": {
          "default": true,
          "title": "Human Approval Required",
          "type": "boolean"
        }
      },
      "title": "AIPolicy",
      "type": "object"
    },
    "ApprovalPolicy": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "minimum_approvals": {
          "default": 1,
          "maximum": 10,
          "minimum": 1,
          "title": "Minimum Approvals",
          "type": "integer"
        },
        "allowed_roles": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Allowed Roles",
          "type": "array"
        },
        "rationale_required": {
          "default": true,
          "title": "Rationale Required",
          "type": "boolean"
        },
        "creator_may_approve": {
          "default": false,
          "title": "Creator May Approve",
          "type": "boolean"
        }
      },
      "title": "ApprovalPolicy",
      "type": "object"
    },
    "DataClassification": {
      "enum": [
        "synthetic",
        "public",
        "internal_non_sensitive",
        "confidential_restricted"
      ],
      "title": "DataClassification",
      "type": "string"
    },
    "FieldDefinition": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "field_type": {
          "$ref": "#/$defs/FieldType"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "help_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Help Text"
        },
        "default": {
          "default": null,
          "title": "Default"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Options",
          "type": "array"
        },
        "sensitive": {
          "default": false,
          "title": "Sensitive",
          "type": "boolean"
        },
        "validation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValidationConstraint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "field_id",
        "label",
        "field_type"
      ],
      "title": "FieldDefinition",
      "type": "object"
    },
    "FieldType": {
      "enum": [
        "text",
        "textarea",
        "integer",
        "number",
        "boolean",
        "date",
        "datetime",
        "select",
        "multiselect"
      ],
      "title": "FieldType",
      "type": "string"
    },
    "LifecycleStatus": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "published",
        "archived"
      ],
      "title": "LifecycleStatus",
      "type": "string"
    },
    "OutputField": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "field_type": {
          "$ref": "#/$defs/OutputFieldType"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "enum": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Enum",
          "type": "array"
        }
      },
      "required": [
        "field_id",
        "label",
        "field_type"
      ],
      "title": "OutputField",
      "type": "object"
    },
    "OutputFieldType": {
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "date",
        "datetime",
        "array",
        "object"
      ],
      "title": "OutputFieldType",
      "type": "string"
    },
    "OutputSchemaDefinition": {
      "additionalProperties": false,
      "properties": {
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/OutputField"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "schema_id",
        "fields"
      ],
      "title": "OutputSchemaDefinition",
      "type": "object"
    },
    "PromptTemplate": {
      "additionalProperties": false,
      "properties": {
        "prompt_id": {
          "title": "Prompt Id",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/LifecycleStatus",
          "default": "draft"
        },
        "system_instruction": {
          "maxLength": 8000,
          "minLength": 10,
          "title": "System Instruction",
          "type": "string"
        },
        "task_template": {
          "maxLength": 16000,
          "minLength": 10,
          "title": "Task Template",
          "type": "string"
        },
        "variables": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Variables",
          "type": "array"
        },
        "response_schema_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Schema Id"
        }
      },
      "required": [
        "prompt_id",
        "version",
        "system_instruction",
        "task_template"
      ],
      "title": "PromptTemplate",
      "type": "object"
    },
    "RoutingAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "when_rule_id": {
          "title": "When Rule Id",
          "type": "string"
        },
        "action_type": {
          "$ref": "#/$defs/RoutingActionType"
        },
        "value": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "when_rule_id",
        "action_type",
        "value"
      ],
      "title": "RoutingAction",
      "type": "object"
    },
    "RoutingActionType": {
      "enum": [
        "assign_role",
        "set_severity",
        "set_category",
        "require_approval",
        "escalate",
        "require_follow_up"
      ],
      "title": "RoutingActionType",
      "type": "string"
    },
    "RuleDefinition": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/RuleOperator"
        },
        "value": {
          "title": "Value"
        },
        "message": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Message",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "priority": {
          "default": 100,
          "maximum": 10000,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        }
      },
      "required": [
        "rule_id",
        "field_id",
        "operator",
        "value",
        "message"
      ],
      "title": "RuleDefinition",
      "type": "object"
    },
    "RuleOperator": {
      "enum": [
        "equals",
        "not_equals",
        "contains",
        "greater_than",
        "less_than",
        "in"
      ],
      "title": "RuleOperator",
      "type": "string"
    },
    "SyntheticTestCase": {
      "additionalProperties": false,
      "properties": {
        "test_case_id": {
          "title": "Test Case Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/DataClassification",
          "default": "synthetic"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "expected_rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Expected Rule Ids",
          "type": "array"
        },
        "expected_routing_action_ids": {
          "items": {
            "type": "string"
          },
          "title": "Expected Routing Action Ids",
          "type": "array"
        }
      },
      "required": [
        "test_case_id",
        "name",
        "input"
      ],
      "title": "SyntheticTestCase",
      "type": "object"
    },
    "ValidationConstraint": {
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "min_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Length"
        },
        "max_length": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Length"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        }
      },
      "title": "ValidationConstraint",
      "type": "object"
    },
    "WorkflowMetadata": {
      "additionalProperties": false,
      "properties": {
        "workflow_id": {
          "title": "Workflow Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 10,
          "title": "Description",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        },
        "owner": {
          "maxLength": 120,
          "minLength": 2,
          "title": "Owner",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/LifecycleStatus",
          "default": "draft"
        },
        "definition_version": {
          "default": "1.1",
          "title": "Definition Version",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "workflow_id",
        "name",
        "description",
        "version",
        "owner"
      ],
      "title": "WorkflowMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "$ref": "#/$defs/WorkflowMetadata"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FieldDefinition"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Fields",
      "type": "array"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RuleDefinition"
      },
      "maxItems": 200,
      "title": "Rules",
      "type": "array"
    },
    "routing_actions": {
      "items": {
        "$ref": "#/$defs/RoutingAction"
      },
      "maxItems": 200,
      "title": "Routing Actions",
      "type": "array"
    },
    "prompts": {
      "items": {
        "$ref": "#/$defs/PromptTemplate"
      },
      "maxItems": 50,
      "title": "Prompts",
      "type": "array"
    },
    "output_schemas": {
      "items": {
        "$ref": "#/$defs/OutputSchemaDefinition"
      },
      "maxItems": 20,
      "title": "Output Schemas",
      "type": "array"
    },
    "ai_policy": {
      "$ref": "#/$defs/AIPolicy"
    },
    "allowed_input_classifications": {
      "items": {
        "$ref": "#/$defs/DataClassification"
      },
      "title": "Allowed Input Classifications",
      "type": "array"
    },
    "approval": {
      "$ref": "#/$defs/ApprovalPolicy"
    },
    "test_cases": {
      "items": {
        "$ref": "#/$defs/SyntheticTestCase"
      },
      "maxItems": 50,
      "title": "Test Cases",
      "type": "array"
    },
    "extensions": {
      "additionalProperties": true,
      "title": "Extensions",
      "type": "object"
    }
  },
  "required": [
    "metadata",
    "fields"
  ],
  "title": "WorkflowDefinition",
  "type": "object"
}
